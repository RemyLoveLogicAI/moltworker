# ============================================================
# SECURITY: Prevent accidental secret commits
# ============================================================

# Credential files
*credentials*
*secrets*
*.pem
*.key
*.cert
*.p12
*.pfx

# Common secret file names
.secret
.secrets
secret.txt
secrets.txt
secrets.json
credentials.json
auth.json

# API key files
*api-key*
*apikey*
*api_key*
*.token
.token

# Config files that may contain secrets
config.local.*
config.production.*
config.staging.*
config.development.*
local.config.*
